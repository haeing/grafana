          "query": "SELECT mean(\"setpoint_1_k\") FROM \"lakeshore325\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "Target Set Temperature"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kelvin",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": 30000,
            "axisLabel": "Temperature (K)"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "interval": "10s"
    },
    {
      "id": 6,
      "title": "Heater Output",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "gl840-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT mean(\"heater_output_percent\") FROM \"lakeshore325\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "Heater Output"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": 30000,
            "axisLabel": "Heater output (%)"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "interval": "10s"
    }
  ],
  "description": "Live GL840 readings every 30 seconds. Target: (CH1 voltage - 1) * 937.58 Torr. Chamber: 10^(2*(CH3 voltage - 5.5)) Torr. Timestamps are computer acquisition times.",
  "tags": [
    "COREA",
    "Gas Target"
  ]
}
