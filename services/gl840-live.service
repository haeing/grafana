[Unit]
Description=COREA GL840 pressure collection
After=network-online.target influxdb.service
Requires=influxdb.service
Wants=network-online.target
[Service]
User=hanul
ExecStart=/usr/bin/python3 /share/grafana/collectors/gl840.py
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
